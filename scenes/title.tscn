[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/title.gd" id="1_title"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.035, 0.032, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -160.0
offset_right = 220.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 18
alignment = 1

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.90, 0.84, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.85)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 56
text = "THE WINDOW"
horizontal_alignment = 1

[node name="Rule" type="ColorRect" parent="VBox"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.72, 0.42, 0.18, 0.85)

[node name="Sub" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.70, 0.48, 0.30, 0.92)
theme_override_font_sizes/font_size = 16
text = "A luxury office. Denver is on fire.
Click Play  ·  Enter also starts"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2

[node name="Play" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Play"

[node name="Quit" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Quit"

[connection signal="pressed" from="Play" to="." method="_on_play"]
[connection signal="pressed" from="Quit" to="." method="_on_quit"]
